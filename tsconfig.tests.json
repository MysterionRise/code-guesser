{
  // Test files and e2e specs, which Vitest and Playwright run without checking types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["node"],
    "types": ["node"],
    // Vitest's bundled Vite declarations do not pass exactOptionalPropertyTypes;
    // the source projects still check library declarations.
    "skipLibCheck": true
  },
  "include": [
    "apps/game/test/**/*.ts",
    "apps/game/test/**/*.tsx",
    // The global error page, which a test renders, imports the global style sheet.
    "apps/game/src/styles.d.ts",
    "packages/*/test/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/accessibility/**/*.ts",
    "tests/performance/**/*.ts",
    "tests/production/**/*.ts",
    "playwright.config.ts",
    "playwright.production.config.ts"
  ]
}
