{
  "name": "codeguessr",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.22.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "test": "node --test packages/test-support/workspace.test.mjs && vitest run --passWithNoTests",
    "test:a11y": "node tests/accessibility/run-accessibility.mjs",
    "test:e2e": "node tests/e2e/run-playwright.mjs",
    "test:performance": "node --test tests/performance/*.test.mjs",
    "test:deploy": "node --test tests/deploy/*.test.mjs",
    "acquire:content": "node --import tsx ops/content/acquire/index.ts",
    "prepare:poc": "node --import tsx ops/poc/prepare/index.ts",
    "prepare:questions": "node --import tsx ops/poc/questions/index.ts",
    "demo:record": "node --import tsx ops/demo/record/index.ts",
    "experiment:report": "node --import tsx ops/experiment/index.ts",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc --noEmit -p ops/tsconfig.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codeguessr/content": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31"
    }
  }
}
